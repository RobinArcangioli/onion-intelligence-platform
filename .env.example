# UNIQUEMENT POUR ENVIRONNEMENT DE DEVELOPPEMENT LOCAL
OIP_DB_USER=oip
OIP_DB_NAME=oip
OIP_DB_PASSWORD=replace_with_long_random_password
OIP_API_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Disabled by default in v1 release candidate. If upgrading, test a personal ADMIN token before changing an existing .env.
OIP_LEGACY_API_KEY_ENABLED=false
