[Unit]
Description=OIP encrypted PostgreSQL backup to independent SSH destination
After=docker.service network-online.target
Wants=docker.service network-online.target
OnFailure=oip-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/oip/backup.env
ExecStart=/usr/bin/bash /opt/oip/onion-intelligence-platform/deploy/ovh/backup-offsite.sh
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/oip-monitor
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
