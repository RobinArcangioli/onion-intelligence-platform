[Unit]
Description=OIP local health, resource and private-network probe
After=docker.service
Wants=docker.service
OnFailure=oip-alert@%n.service

[Service]
Type=oneshot
User=root
Environment=OIP_MONITOR_REQUIRE_BACKUP=0
EnvironmentFile=-/etc/oip/monitor.env
ExecStart=/usr/bin/python3 /opt/oip/onion-intelligence-platform/deploy/ovh/monitor.py
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
