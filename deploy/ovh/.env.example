# Aide-mémoire uniquement : ne pas utiliser ce fichier avec Docker Compose.
# Créer et protéger le fichier racine .env (chmod 600) en reprenant les noms
# de .env.example à la racine. Ne jamais publier ou copier des secrets dans Git.
# Les secrets doivent être nouveaux et distincts ; les placeholders sont refusés.
OIP_DB_USER=oip
OIP_DB_NAME=oip
OIP_DB_PASSWORD=replace_with_unique_random_password_32_chars_or_more
OIP_API_KEY=replace_with_distinct_random_legacy_key_32_chars_or_more
OIP_LEGACY_API_KEY_ENABLED=false
# OIP_MANUAL_COLLECTION_ENABLED est forcé à false dans compose.private.yaml.
# Le worker Tor n'est jamais lancé par le script OVH.

# M2-C (futures installations Tor autorisées seulement):
# Les limites sont transmises par compose.yaml ; l'overlay OVH garde Tor éteint.
OIP_COLLECTION_EMERGENCY_STOP=false
OIP_COLLECTION_SOURCE_COOLDOWN_SECONDS=300
OIP_COLLECTION_MAX_PENDING=25
OIP_COLLECTION_MAX_RUNNING=2
OIP_COLLECTION_CIRCUIT_FAILURES=3
OIP_COLLECTION_CIRCUIT_OPEN_SECONDS=3600
